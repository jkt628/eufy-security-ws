{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Server",
      "preLaunchTask": "compile",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "! [ -e .env ] || export $(xargs < .env); ./docker/run.sh"
      ],
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "console": "integratedTerminal"
    }
  ]
}
